# токен от @BotFather
BOT_TOKEN=your_bot_token

# id тгк для публикации (add bot as admin)
# получить можно через @userinfobot или из ссылки t.me/c/1234567890/1
CHANNEL_ID=-1001234567890

# id админов через запятую — для них нет лимита 1 пост в 24ч
# узнать свой id: @userinfobot
# ADMIN_IDS=123456789,987654321

# прокси для telegram api (нужен из-за блокировки с рф ip)
# http://user:pass@host:port  или  socks5://user:pass@host:port
# TELEGRAM_PROXY=socks5://user:pass@1.2.3.4:1080
